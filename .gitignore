# Entornos virtuales y archivos de Python
.venv/
venv/
__pycache__/
**/__pycache__/
*.py[cod]
*.pyc

# Audios descargados (se conserva la carpeta vacía)
downloads/*
!downloads/.gitkeep
*.mp3
*.m4a
*.aac
*.opus
*.webm
*.wav
*.flac
*.ogg
/tools/

# Registros, temporales y credenciales locales
*.log
*.tmp
*.temp
*.bak
*.part
*.ytdl
settings.json
history.json
.env
.env.*
cookies.txt
*.cookies

# Resultados de PyInstaller
build/
dist/
_backups/

# Paquetes binarios generados para GitHub Releases
release/windows/*.zip
release/windows/*.exe
release/linux/*.AppImage
release/linux/*.tar.gz
release/linux/*.deb

# Configuración de editores y sistema operativo
.idea/
.vscode/
.DS_Store
Thumbs.db
